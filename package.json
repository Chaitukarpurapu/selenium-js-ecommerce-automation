{
  "name": "selenium-js-ecommerce-automation",
  "version": "1.0.0",
  "description": "Portfolio-ready UI test automation framework using Selenium WebDriver, JavaScript, Mocha and Chai.",
  "private": false,
  "scripts": {
    "test": "mocha \"test/**/*.spec.js\" --timeout 30000",
    "test:headed": "cross-env HEADLESS=false mocha \"test/**/*.spec.js\" --timeout 30000",
    "test:smoke": "mocha \"test/smoke/**/*.spec.js\" --timeout 30000"
  },
  "keywords": ["selenium", "webdriver", "javascript", "automation-testing", "mocha", "chai", "page-object-model"],
  "author": "Chaitanya Kishore Karpurapu",
  "license": "MIT",
  "devDependencies": {
    "chai": "^4.5.0",
    "cross-env": "^7.0.3",
    "mocha": "^10.8.2",
    "selenium-webdriver": "^4.27.0",
    "dotenv": "^16.4.5"
  }
}
